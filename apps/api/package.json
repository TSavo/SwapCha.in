{
  "name": "@swapchan/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@anthropic-ai/claude-code": "^2.1.312",
    "@hono/node-server": "2.1.5",
    "@noble/curves": "1.9.7",
    "@relay-protocol/settlement-sdk": "0.0.151",
    "@scure/base": "1.2.6",
    "@swapchan/shared": "workspace:*",
    "bitcoinjs-lib": "^7.0.4",
    "hono": "4.13.13",
    "viem": "2.57.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
