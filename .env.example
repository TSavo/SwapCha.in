# apps/api
PORT=8787
LIFI_API_KEY=          # optional; raises LI.FI rate limits (https://portal.li.fi)
ZEROX_API_KEY=         # required for 0x adapter (https://dashboard.0x.org)
SWAPCHAN_FEE_BPS=10    # integrator fee, basis points
SWAPCHAN_FEE_RECIPIENT=
# apps/web
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_REOWN_PROJECT_ID= # https://dashboard.reown.com
# auth: "key:requestsPerMinute,..." ; empty = open dev mode
SWAPCHAN_API_KEYS=
# optional provider keys (all keyless otherwise; keys raise rate limits)
RELAY_API_KEY=
VELORA_API_KEY=
# /build simulation: eth_call | tenderly | empty (off)
SWAPCHAN_SIMULATE=
RPC_URL_1=             # optional per-chain RPC for eth_call (RPC_URL_<chainId>)
TENDERLY_ACCOUNT=
TENDERLY_PROJECT=
TENDERLY_ACCESS_KEY=
# apps/mcp
SWAPCHAN_API_URL=http://localhost:8787
SWAPCHAN_API_KEY=      # a key from SWAPCHAN_API_KEYS if auth is on
MCP_PORT=8788
MCP_API_KEYS=          # comma list; `pnpm dev` sets MCP_ALLOW_ANONYMOUS=1
